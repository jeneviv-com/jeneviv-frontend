# ============================================================================
# JENEVIV WEBAPP - ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================================
# Copy this file to .env.local and fill in your actual credentials
# NEVER commit .env.local to version control
# ============================================================================

# ============================================================================
# API & BACKEND CONFIGURATION
# ============================================================================

# Backend API URL (must match main frontend's NEXT_PUBLIC_API_URL)
# Development: http://localhost:3001
# Production: https://api.jeneviv.com
VITE_API_URL=http://localhost:3001

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# App name
VITE_APP_NAME=Jeneviv

# Webapp base URL
VITE_APP_URL=http://localhost:5173

# ============================================================================
# FEATURE FLAGS & MONITORING
# ============================================================================

# Analytics
VITE_ENABLE_ANALYTICS=false
# VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X

# Error tracking (Sentry)
VITE_ENABLE_SENTRY=false
# VITE_SENTRY_DSN=your_sentry_dsn_here
