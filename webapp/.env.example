# ============================================================================
# JENEVIV DASHBOARD — ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy to .env.local and fill in real values. Never commit .env.local.
# Full reference: ../ENV_CONFIG.md
# ============================================================================

# Backend API origin (Express). Must match the API's PORT and BETTER_AUTH_URL.
# Development: http://localhost:3001
# Production:  https://api.jeneviv.com
VITE_API_URL=http://localhost:3001

# Marketing site origin. Used for legal links and "View landing page".
VITE_PUBLIC_APP_URL=http://localhost:3000

# Origin used for public payer links (defaults to the current origin).
# Set this when payer pages live on a dedicated host, e.g. https://pay.jeneviv.com
# VITE_PAY_BASE_URL=http://localhost:5173

# auto  = probe the API, fall back to seeded demo data if it is unreachable
# false = always use the real API (recommended when testing connectivity)
# true  = always use demo data
VITE_DEMO_MODE=auto

# Router base path when the dashboard is mounted on a sub-path, e.g. /app
# VITE_BASE_PATH=/

# Display name fallback
VITE_APP_NAME=Jeneviv

# --- Reserved feature flags (no SDK wired up yet) ---------------------------
VITE_ENABLE_ANALYTICS=false
# VITE_GOOGLE_ANALYTICS_ID=
VITE_ENABLE_SENTRY=false
# VITE_SENTRY_DSN=
