# ============================================================================
# JENEVIV MARKETING SITE (Next.js) — ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy to .env.local and fill in real values. Never commit .env.local.
# Full reference: ENV_CONFIG.md
# ============================================================================

# Dashboard (Vite) origin. All sign-up / sign-in / open-app links use this.
# Development: http://localhost:5173
# Production:  https://app.jeneviv.com
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Public origin of this marketing site. Drives canonical URLs, Open Graph,
# robots.txt and sitemap.xml.
# Development: http://localhost:3000
# Production:  https://jeneviv.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reserved for a future server-side API client. The marketing pages do not
# call the API today. Keep equal to the dashboard's VITE_API_URL if used.
NEXT_PUBLIC_API_URL=http://localhost:3001
